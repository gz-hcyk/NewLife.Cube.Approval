<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Approval.Data</RootNamespace>
    <AssemblyName>NewLife.Cube.Approval</AssemblyName>
    <PackageId>NewLife.Cube.Approval</PackageId>
